# NCKU Smart Commute 本機設定範例
# 複製為 .env 後填入自己的金鑰；請勿把 .env 提交到版本控制。

# ---- 執行模式 ----
# fixture：使用測試資料，不需網路或金鑰；live：呼叫真實服務
PROVIDER_MODE=fixture
APP_ENV=development
TIMEZONE=Asia/Taipei
HTTP_TIMEOUT_SECONDS=8

# ---- Gemini ----
# 擇一填寫即可；GOOGLE_API_KEY 的優先順序高於 GEMINI_API_KEY。
GOOGLE_API_KEY=
GEMINI_API_KEY=
# 使用 AI Studio API key（非 Vertex AI）時維持 FALSE。
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-3-flash-preview

# ---- 成大公開服務（通常無須修改） ----
NCKU_GIS_BASE_URL=https://db.nckumap.ncku.edu.tw/nckugis/public
NCKU_PARKING_BASE_URL=https://apss.oga.ncku.edu.tw/park/index.php/park11215

# ---- 課表與預設出發地 ----
CLASS_SCHEDULE_PATH=data/class_schedule.json
USER_SCHEDULE_PATH=data/user_schedule.json
# 可填住家或常用起點；含個人地址，請僅放在自己的 .env。
DEFAULT_ORIGIN=

# ---- 路線時間 ----
# auto：能免費估算時優先使用；estimate：完全不使用 Google；google：固定使用 Google Routes（可能計費）
TRAVEL_TIME_PROVIDER=auto
GOOGLE_MAPS_API_KEY=

# ---- 選用功能 ----
# 天氣（中央氣象署）
CWA_API_KEY= 
# 臺南公車即時資訊（TDX）
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
